<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
<title>디즈니 타자 게임</title>
<meta property="og:title" content="디즈니 타자 게임">
<meta property="og:description" content="30초 동안 디즈니 캐릭터 이름을 몇 개나 칠 수 있을까요?">
<style>
  :root {
    --bg: #101a3a; --card: #ffffff; --ink: #1b2340; --sub: #6b7390;
    --accent: #e4002b; --gold: #f5b800; --no: #e4002b; --line: #e6e8f0;
  }
  * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
  html, body { margin: 0; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, "Apple SD Gothic Neo", "Malgun Gothic", "Noto Sans KR", sans-serif;
    background: var(--bg); color: var(--ink);
    display: flex; justify-content: center; padding: 16px;
  }
  .wrap { width: 100%; max-width: 420px; }
  .screen { display: none; }
  .screen.on { display: block; }
  .card { background: var(--card); border-radius: 20px; padding: 22px 18px; margin-bottom: 14px; text-align: center; }
  h1 { font-size: 26px; margin: 4px 0 6px; }
  .lead { color: var(--sub); font-size: 14px; line-height: 1.5; margin: 0 0 16px; }
  input[type=text] {
    width: 100%; font-size: 18px; padding: 14px; border: 2px solid var(--line);
    border-radius: 12px; text-align: center; outline: none; font-family: inherit;
  }
  input[type=text]:focus { border-color: var(--ink); }
  .btn {
    width: 100%; font-size: 18px; font-weight: 700; padding: 15px; margin-top: 12px;
    border: 0; border-radius: 12px; background: var(--accent); color: #fff; cursor: pointer;
  }
  .btn:disabled { opacity: .5; }
  .link { background: none; border: 0; color: var(--sub); font-size: 13px; text-decoration: underline; margin-top: 12px; cursor: pointer; }
  .msg { color: var(--no); font-size: 13px; min-height: 18px; margin-top: 8px; }
  .me { font-size: 15px; margin-bottom: 4px; }
  .me b { font-size: 18px; }
  .code { font-family: ui-monospace, Menlo, Consolas, monospace; letter-spacing: 2px; font-weight: 700; }

  .top3 h2 { font-size: 15px; margin: 0 0 10px; color: var(--sub); }
  .top3 ol { list-style: none; margin: 0; padding: 0; }
  .top3 li { display: flex; justify-content: space-between; padding: 9px 4px; font-size: 16px; border-top: 1px solid var(--line); }
  .top3 li:first-child { border-top: 0; }
  .top3 .empty { color: var(--sub); font-size: 14px; justify-content: center; }

  /* 게임 화면 (키보드가 올라와도 보이도록 위쪽에 모아둠) */
  .hud { display: flex; justify-content: space-between; color: #fff; font-weight: 700; font-size: 18px; margin-bottom: 8px; }
  .bar { height: 8px; background: rgba(255,255,255,.2); border-radius: 4px; overflow: hidden; margin-bottom: 12px; }
  .bar i { display: block; height: 100%; width: 100%; background: var(--gold); }
  .board { padding: 18px; transition: background .15s; }
  .board.good { background: #d9f6e4; }
  .board.bad { background: #ffe0e5; }
  .word { font-size: 44px; font-weight: 800; min-height: 58px; line-height: 58px; margin-bottom: 12px; }
  .row { display: flex; gap: 8px; }
  .row input { flex: 1; min-width: 0; }
  .row .btn { width: auto; margin: 0; padding: 0 20px; }
  .hint { color: rgba(255,255,255,.7); font-size: 13px; text-align: center; }
  .count { position: fixed; inset: 0; background: rgba(16,26,58,.92); color: #fff; font-size: 110px; font-weight: 800;
           display: none; align-items: flex-start; justify-content: center; padding-top: 18vh; z-index: 9; }
  .count.on { display: flex; }

  /* 결과 화면 */
  .big { font-size: 24px; font-weight: 800; margin: 4px 0 8px; }
  .acc { font-size: 17px; color: var(--sub); }
  .grade { display: inline-block; margin: 12px 0; padding: 8px 14px; border-radius: 999px; background: #fff3c4; font-weight: 700; }
  .rank { font-size: 28px; font-weight: 800; margin: 6px 0 2px; }
  .ranksub { font-size: 13px; color: var(--sub); min-height: 16px; }
  .codebox { margin: 14px 0 6px; padding: 12px; border: 2px dashed var(--line); border-radius: 12px; }
  .codebox .code { font-size: 26px; }
  .codebox small { display: block; color: var(--sub); margin-top: 4px; font-size: 12px; }
  .prize { font-size: 14px; line-height: 1.5; margin-top: 10px; }
</style>
</head>
<body>
<div class="wrap">

  <!-- ① 첫 화면 -->
  <section id="home" class="screen on">
    <div class="card">
      <h1>⌨️ 디즈니 타자 게임</h1>
      <p class="lead">화면에 나오는 디즈니 캐릭터 이름을<br>30초 동안 최대한 많이 따라 쳐보세요!</p>

      <div id="newPlayer">
        <input type="text" id="nick" maxlength="10" placeholder="닉네임 (최대 10자)" autocomplete="off">
        <input type="text" id="oldCode" maxlength="6" placeholder="참여코드 6자리" autocomplete="off"
               autocapitalize="characters" style="display:none;margin-top:8px">
      </div>
      <div id="oldPlayer" style="display:none">
        <div class="me"><b id="meNick"></b> 님</div>
        <div class="me">참여코드 <span class="code" id="meCode"></span></div>
      </div>

      <button class="btn" id="startBtn">게임 시작</button>
      <div class="msg" id="homeMsg"></div>
      <button class="link" id="resetBtn" style="display:none">다른 닉네임으로 참여하기</button>
    </div>
    <div class="card top3">
      <h2>실시간 TOP 3</h2>
      <ol class="top3list"><li class="empty">불러오는 중…</li></ol>
    </div>
  </section>

  <!-- ② 게임 화면 -->
  <section id="game" class="screen">
    <div class="hud"><span>⏱ <span id="time">30.0</span>초</span><span>✅ <span id="score">0</span>개</span></div>
    <div class="bar"><i id="barFill"></i></div>
    <div class="card board" id="board">
      <div class="word" id="word"></div>
      <form class="row" id="form" autocomplete="off">
        <input type="text" id="answer" placeholder="여기에 입력" autocomplete="off" autocorrect="off"
               autocapitalize="off" spellcheck="false" enterkeyhint="done">
        <button class="btn" id="submitBtn" type="submit">입력</button>
      </form>
    </div>
    <div class="hint">다 쳤으면 엔터(완료) 또는 [입력] 버튼!</div>
  </section>

  <!-- ③ 결과 화면 -->
  <section id="result" class="screen">
    <div class="card">
      <div class="big" id="resScore"></div>
      <div class="acc" id="resAcc"></div>
      <div class="grade" id="resGrade"></div>
      <div class="rank" id="resRank">순위 계산 중…</div>
      <div class="ranksub" id="resRankSub"></div>
      <div class="codebox">
        참여코드: <span class="code" id="resCode"></span>
        <small>당첨 확인을 위해 참여코드를 기억해주세요.</small>
      </div>
      <p class="prize">이벤트 종료 후 최종 1~3위에게<br>디즈니스토어의 선물을 드립니다 🎁</p>
      <button class="btn" id="saveRetryBtn" style="display:none;background:#1b2340">기록 다시 저장하기</button>
      <button class="btn" id="againBtn">다시 도전하기</button>
      <div class="msg" id="resMsg"></div>
    </div>
    <div class="card top3">
      <h2>실시간 TOP 3</h2>
      <ol class="top3list"><li class="empty">불러오는 중…</li></ol>
    </div>
  </section>
</div>

<div class="count" id="count">3</div>

<script>
  /* ▼▼▼ 여기 한 곳만 고치면 됩니다 ▼▼▼
     Apps Script 배포 후 받은 웹 앱 URL(끝이 /exec)을 작은따옴표 안에 붙여넣으세요. */
  var API_URL = 'https://script.google.com/macros/s/AKfycbwPbO7A34223I53LHJtbJXPqgxJkfvgFz8GE95xbbqGhWANEI3UkW4Fva3IDFMG6ZPI/exec';
  /* ▲▲▲ 여기까지 ▲▲▲ */

  /* ===== 게임 설정 (원하면 바꿀 수 있는 부분) ===== */
  var DURATION = 30;   // 제한시간(초). Code.gs의 GAME_DURATION과 같게

  // 따라 칠 단어 목록. '이름', 형식으로 자유롭게 넣고 빼세요. (띄어쓰기는 채점에서 무시됩니다)
  var WORDS = [
    '미키', '미니', '도날드', '데이지', '구피', '플루토', '칩', '데일', '휴이', '듀이', '루이', '스크루지', '클라라벨', '피트',
    '푸', '티거', '피글렛', '이요르', '래빗', '캉가',
    '스티치', '릴로', '나니', '점바', '플리클리', '엔젤',
    '우디', '버즈', '제시', '렉스', '햄', '포키', '랏소', '슬링키', '불스아이', '보핍', '앤디', '보니', '듀크카붐', '버니', '더키', '개비개비',
    '엘사', '안나', '올라프', '크리스토프', '스벤', '한스', '브루니',
    '심바', '날라', '티몬', '품바', '무파사', '스카', '라피키', '자주',
    '니모', '도리', '말린', '크러쉬', '행크', '길',
    '알라딘', '자스민', '지니', '아부', '자파', '이아고',
    '라푼젤', '플린', '파스칼', '막시무스',
    '모아나', '마우이', '푸아', '헤이헤이',
    '덤보', '밤비', '덤퍼', '플라워',
    '베이맥스', '히로',
    '설리', '마이크', '부', '랜달',
    '에리얼', '세바스찬', '플라운더', '우르슬라', '에릭',
    '벨', '야수', '가스통', '루미에', '콕스워스',
    '신데렐라', '오로라', '백설공주', '뮬란', '무슈', '포카혼타스', '미코', '티아나', '메리다', '라야', '시수', '미라벨',
    '피터팬', '팅커벨', '웬디', '후크',
    '피노키오', '지미니', '제페토',
    '앨리스', '체셔캣', '하트여왕',
    '주디', '닉', '플래시',
    '레미', '링귀니',
    '대쉬', '바이올렛', '잭잭', '엘라스티걸', '에드나',
    '맥퀸', '메이터', '샐리',
    '기쁨', '슬픔', '버럭', '까칠', '소심', '빙봉', '라일리', '불안',
    '미구엘', '헥터', '단테',
    '칼', '러셀', '더그', '케빈',
    '랄프', '바넬로피', '펠릭스',
    '타잔', '제인', '헤라클레스', '메그', '하데스', '말레피센트', '크루엘라', '마리', '루카', '알베르토', '앰버', '웨이드', '메이'
  ];

  var GRADES = [       // 결과 등급 (점수 이상이면 해당 등급)
    { min: 16, label: '✨ 전설의 디즈니 타자왕' },
    { min: 11, label: '🏰 디즈니 찐팬' },
    { min: 6,  label: '🎀 디즈니 입문자' },
    { min: 0,  label: '🌱 새싹 손가락' }
  ];
  /* ========================================== */

  var player = null;
  var st = { score: 0, attempts: 0, word: '', token: null, endAt: 0, timer: null, playing: false, counted: false, failed: false };
  var $ = function (id) { return document.getElementById(id); };

  /* ----- 서버(구글 시트) 통신 ----- */
  function callServer(action, args, ok, fail) {
    fetch(API_URL, {
      method: 'POST',
      headers: { 'Content-Type': 'text/plain;charset=utf-8' },
      body: JSON.stringify({ action: action, args: args })
    })
      .then(function (r) { if (!r.ok) throw new Error('서버 응답 ' + r.status); return r.json(); })
      .then(function (res) { if (res && res.__error) fail(new Error(res.__error)); else ok(res); })
      .catch(function (err) { fail(err); });
  }
  function server() {
    var ok = function () {}, fail = function () {};
    var run = {
      withSuccessHandler: function (f) { ok = f; return run; },
      withFailureHandler: function (f) { fail = f; return run; }
    };
    ['getTop3', 'registerPlayer', 'startGame', 'saveResult'].forEach(function (name) {
      run[name] = function () { callServer(name, Array.prototype.slice.call(arguments), ok, fail); };
    });
    return run;
  }

  function show(id) {
    ['home', 'game', 'result'].forEach(function (s) { $(s).classList.toggle('on', s === id); });
    window.scrollTo(0, 0);
  }

  /* ----- 참여자 정보 (같은 기기에서는 닉네임·코드 유지) ----- */
  function loadPlayer() {
    try {
      var p = JSON.parse(localStorage.getItem('disneyTypingPlayer') || 'null');
      if (p && p.nickname && p.code) player = p;
    } catch (e) {}
  }
  function savePlayer() { try { localStorage.setItem('disneyTypingPlayer', JSON.stringify(player)); } catch (e) {} }
  function clearPlayer() { player = null; try { localStorage.removeItem('disneyTypingPlayer'); } catch (e) {} }

  function renderHome() {
    $('newPlayer').style.display = player ? 'none' : 'block';
    $('oldPlayer').style.display = player ? 'block' : 'none';
    $('resetBtn').style.display = player ? 'inline-block' : 'none';
    if (player) { $('meNick').textContent = player.nickname; $('meCode').textContent = player.code; }
  }

  /* ----- TOP 3 ----- */
  function renderTop3(list) {
    var medals = ['🥇', '🥈', '🥉'];
    var lists = document.querySelectorAll('.top3list');
    for (var k = 0; k < lists.length; k++) {
      var ol = lists[k];
      ol.innerHTML = '';
      if (!list || !list.length) {
        var e = document.createElement('li');
        e.className = 'empty';
        e.textContent = '아직 기록이 없어요. 첫 번째 주인공이 되어보세요!';
        ol.appendChild(e);
        continue;
      }
      list.forEach(function (r, i) {
        var li = document.createElement('li');
        var a = document.createElement('span'); a.textContent = medals[i] + ' ' + r.nickname;
        var b = document.createElement('b'); b.textContent = r.score + '개';
        li.appendChild(a); li.appendChild(b);
        ol.appendChild(li);
      });
    }
  }
  function loadTop3() {
    server().withSuccessHandler(renderTop3).withFailureHandler(function () { renderTop3([]); }).getTop3();
  }

  /* ----- 시작 ----- */
  function onStartClick() {
    $('homeMsg').textContent = '';
    if (player) { begin(); return; }
    var nick = $('nick').value.trim();
    if (!nick) { $('homeMsg').textContent = '닉네임을 입력해주세요.'; return; }
    var btn = $('startBtn');
    btn.disabled = true;
    server()
      .withSuccessHandler(function (res) {
        btn.disabled = false;
        if (!res.ok) {
          $('homeMsg').textContent = res.message;
          if (res.taken) $('oldCode').style.display = 'block';
          return;
        }
        $('oldCode').style.display = 'none'; $('oldCode').value = '';
        player = { nickname: res.nickname, code: res.code };
        savePlayer(); renderHome();
        begin();
      })
      .withFailureHandler(function () { btn.disabled = false; $('homeMsg').textContent = '연결이 불안정해요. 다시 시도해주세요.'; })
      .registerPlayer(nick, $('oldCode').value);
  }

  /* 버튼을 누른 순간 입력칸에 커서를 줘야 휴대폰 키보드가 올라옵니다 */
  function begin() {
    st.score = 0; st.attempts = 0; st.word = ''; st.token = null; st.counted = false; st.failed = false; st.playing = false;
    $('score').textContent = '0'; $('time').textContent = DURATION.toFixed(1); $('barFill').style.width = '100%';
    $('word').textContent = ''; $('answer').value = '';
    show('game');
    $('answer').focus();

    server()
      .withSuccessHandler(function (token) { st.token = token; maybePlay(); })
      .withFailureHandler(function () { st.failed = true; maybePlay(); })
      .startGame();

    var n = 3, c = $('count');
    c.textContent = n; c.classList.add('on');
    var t = setInterval(function () {
      n--;
      if (n > 0) { c.textContent = n; return; }
      clearInterval(t); st.counted = true; maybePlay();
    }, 1000);
  }

  function maybePlay() {
    if (st.playing) return;
    if (st.failed) {
      if (!st.counted) return;
      $('count').classList.remove('on');
      $('answer').blur();
      renderHome(); show('home');
      $('homeMsg').textContent = '연결이 불안정해요. 다시 시도해주세요.';
      return;
    }
    if (!st.counted || !st.token) return;   // 카운트다운과 서버 준비가 모두 끝나야 시작
    $('count').classList.remove('on');
    st.playing = true;
    nextWord();
    $('answer').focus();
    st.endAt = Date.now() + DURATION * 1000;
    st.timer = setInterval(tick, 100);
  }

  /* ----- 게임 진행 ----- */
  function tick() {
    var left = Math.max(0, st.endAt - Date.now());
    $('time').textContent = (left / 1000).toFixed(1);
    $('barFill').style.width = (left / (DURATION * 10)) + '%';
    if (left <= 0) finish();
  }

  function nextWord() {
    // 전체 단어를 섞어서 한 바퀴 다 돌 때까지 같은 단어가 다시 나오지 않음
    if (!st.bag || !st.bag.length) {
      st.bag = WORDS.slice();
      for (var i = st.bag.length - 1; i > 0; i--) {
        var j = Math.floor(Math.random() * (i + 1));
        var t = st.bag[i]; st.bag[i] = st.bag[j]; st.bag[j] = t;
      }
      if (st.bag.length > 1 && st.bag[st.bag.length - 1] === st.word) st.bag.unshift(st.bag.pop());
    }
    var w = st.bag.pop();
    st.word = w;
    $('word').textContent = w;
    $('answer').value = '';
  }

  function clean(s) { return String(s).normalize('NFC').replace(/\s+/g, '').toLowerCase(); }

  function submitAnswer(e) {
    e.preventDefault();
    if (!st.playing) return;
    var typed = clean($('answer').value);
    if (!typed) return;                      // 빈 칸은 제출로 치지 않음
    st.attempts++;
    var correct = typed === clean(st.word);
    if (correct) { st.score++; $('score').textContent = st.score; }
    var board = $('board');
    board.classList.remove('good', 'bad');
    board.classList.add(correct ? 'good' : 'bad');
    setTimeout(function () { board.classList.remove('good', 'bad'); }, 200);
    nextWord();
    $('answer').focus();
  }

  /* ----- 종료 & 저장 ----- */
  function finish() {
    if (!st.playing) return;
    st.playing = false;
    clearInterval(st.timer);
    $('answer').blur();

    var acc = st.attempts ? Math.round(st.score / st.attempts * 100) : 0;
    var grade = GRADES[GRADES.length - 1].label;
    for (var i = 0; i < GRADES.length; i++) { if (st.score >= GRADES[i].min) { grade = GRADES[i].label; break; } }

    $('resScore').textContent = DURATION + '초 동안 ' + st.score + '개 성공!';
    $('resAcc').textContent = '정확도 ' + acc + '%';
    $('resGrade').textContent = grade;
    $('resCode').textContent = player.code;
    show('result');
    save();
  }

  function save(isAuto) {
    $('resRank').textContent = '순위 계산 중…';
    $('resRankSub').textContent = '';
    $('resMsg').textContent = '';
    $('saveRetryBtn').style.display = 'none';
    $('againBtn').disabled = true;
    var fail = function (message, canRetry) {
      $('againBtn').disabled = false;
      $('resRank').textContent = '순위 확인 불가';
      $('resMsg').textContent = message;
      $('saveRetryBtn').style.display = canRetry ? 'block' : 'none';
    };
    server()
      .withSuccessHandler(function (res) {
        if (!res.ok) { fail(res.message, !!res.retry); return; }
        $('againBtn').disabled = false;
        $('resRank').textContent = '🏆 현재 ' + res.rank + '위';
        $('resRankSub').textContent = res.bestScore > st.score
          ? '내 최고 기록 ' + res.bestScore + '개 기준 · 전체 ' + res.total + '명'
          : '전체 ' + res.total + '명 중';
        renderTop3(res.top3);
      })
      .withFailureHandler(function (err) {
        if (isAuto !== 'retry') { setTimeout(function () { save('retry'); }, 1200); return; }   // 한 번은 자동으로 재시도
        fail('저장에 실패했어요. 다시 저장해주세요. (' + (err && err.message ? err.message : '연결 오류') + ')', true);
      })
      .saveResult({ nickname: player.nickname, code: player.code, score: st.score, attempts: st.attempts, token: st.token });
  }

  /* ----- 버튼 연결 ----- */
  $('startBtn').addEventListener('click', onStartClick);
  $('againBtn').addEventListener('click', begin);
  $('saveRetryBtn').addEventListener('click', function () { save(); });
  $('resetBtn').addEventListener('click', function () { clearPlayer(); renderHome(); $('homeMsg').textContent = ''; });
  $('nick').addEventListener('keydown', function (e) { if (e.key === 'Enter' && !e.isComposing) onStartClick(); });
  $('form').addEventListener('submit', submitAnswer);
  $('answer').addEventListener('paste', function (e) { e.preventDefault(); });
  // [입력] 버튼을 눌러도 키보드가 내려가지 않게
  $('submitBtn').addEventListener('mousedown', function (e) { e.preventDefault(); });
  $('submitBtn').addEventListener('touchend', function (e) { e.preventDefault(); submitAnswer(e); });

  loadPlayer();
  renderHome();
  if (API_URL.indexOf('https://script.google.com/') !== 0) {
    $('startBtn').disabled = true;
    $('homeMsg').textContent = '설정 필요: index.html 안의 API_URL에 웹 앱 URL(/exec)을 넣어주세요.';
    renderTop3([]);
  } else {
    loadTop3();
  }
</script>
</body>
</html>
